{
  "name": "devanalyst",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Frontend Code Inspector",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0",
    "pnpm": ">=10.33.0 <11"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm build:apps",
    "build:packages": "tsc -b tsconfig.packages.json",
    "build:apps": "pnpm --filter playground-react build",
    "dev": "pnpm dev:react",
    "dev:packages": "tsc -b tsconfig.packages.json --watch --preserveWatchOutput",
    "dev:react": "pnpm build:packages && pnpm --filter playground-react dev",
    "typecheck": "pnpm build:packages && tsc -p tsconfig.tools.json --noEmit && pnpm -r typecheck",
    "lint": "eslint packages/core packages/vite-plugin packages/inspector packages/analyzer packages/ai packages/cache packages/cli apps/playground-react scripts tests/active tests/e2e/bridge.spec.ts *.config.* --max-warnings=0 && pnpm check:boundaries && pnpm format:check",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "pnpm build:packages && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:packages": "node scripts/verify-packages.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:packages",
    "test:independent": "node scripts/verify-independent-builds.mjs",
    "test:smoke": "pnpm test && pnpm test:e2e",
    "test:unit": "vitest run --exclude 'tests/active/integration/**'",
    "test:integration": "pnpm build:packages && vitest run tests/active/integration"
  },
  "devDependencies": {
    "@devanalyst/core": "workspace:*",
    "@devanalyst/vite-plugin": "workspace:*",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "ws": "8.22.2"
  }
}
