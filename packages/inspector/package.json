{
  "name": "@sonht113/inspector",
  "version": "0.1.0-beta.1",
  "private": false,
  "description": "DevAnalyst inspector package",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/bridge-runtime.d.ts",
      "import": "./dist/bridge-runtime.js",
      "default": "./dist/bridge-runtime.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js",
      "default": "./dist/metadata.js"
    },
    "./mapping-runtime": {
      "types": "./dist/mapping-runtime.d.ts",
      "import": "./dist/mapping-runtime.js",
      "default": "./dist/mapping-runtime.js"
    },
    "./preanalysis-runtime": {
      "types": "./dist/preanalysis-runtime.d.ts",
      "import": "./dist/preanalysis-runtime.js",
      "default": "./dist/preanalysis-runtime.js"
    },
    "./glossary": {
      "types": "./dist/glossary.d.ts",
      "import": "./dist/glossary.js",
      "default": "./dist/glossary.js"
    },
    "./inspection-client": {
      "types": "./dist/inspection-client.d.ts",
      "import": "./dist/inspection-client.js",
      "default": "./dist/inspection-client.js"
    },
    "./inspection-panel": {
      "types": "./dist/inspection-panel.d.ts",
      "import": "./dist/inspection-panel.js",
      "default": "./dist/inspection-panel.js"
    },
    "./inspection-strings": {
      "types": "./dist/inspection-strings.d.ts",
      "import": "./dist/inspection-strings.js",
      "default": "./dist/inspection-strings.js"
    },
    "./vue-runtime": {
      "types": "./dist/vue-runtime.d.ts",
      "import": "./dist/vue-runtime.js",
      "default": "./dist/vue-runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sonht113/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonht113/dev-analyst.git",
    "directory": "packages/inspector"
  },
  "homepage": "https://github.com/sonht113/dev-analyst#readme",
  "bugs": {
    "url": "https://github.com/sonht113/dev-analyst/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  }
}
