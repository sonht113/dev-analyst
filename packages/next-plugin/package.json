{
  "name": "@sonht113/next-plugin",
  "version": "0.1.0-beta.1",
  "private": false,
  "description": "DevAnalyst next-plugin integration",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js",
      "default": "./dist/loader.js"
    },
    "./mapping-runtime": {
      "types": "./dist/mapping-runtime.d.ts",
      "import": "./dist/mapping-runtime.js",
      "default": "./dist/mapping-runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sonht113/core": "workspace:*",
    "@sonht113/server": "workspace:*",
    "@sonht113/analyzer": "workspace:*",
    "@sonht113/inspector": "workspace:*",
    "chokidar": "5.0.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "@types/ws": "^8.18.0",
    "@types/react": "19.3.0",
    "next": "16.4.6",
    "react": "19.3.1"
  },
  "peerDependencies": {
    "next": "~16.4.6",
    "react": "~19.3.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonht113/dev-analyst.git",
    "directory": "packages/next-plugin"
  },
  "homepage": "https://github.com/sonht113/dev-analyst#readme",
  "bugs": {
    "url": "https://github.com/sonht113/dev-analyst/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  }
}
