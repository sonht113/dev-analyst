{
  "name": "@sonht113/vue-plugin",
  "version": "0.1.0-beta.1",
  "private": false,
  "description": "DevAnalyst vue-plugin integration",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sonht113/server": "workspace:*",
    "@sonht113/vite-plugin": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "@types/ws": "^8.18.0"
  },
  "peerDependencies": {
    "vite": "^8.3.5",
    "vue": "~3.5.45"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonht113/dev-analyst.git",
    "directory": "packages/vue-plugin"
  },
  "homepage": "https://github.com/sonht113/dev-analyst#readme",
  "bugs": {
    "url": "https://github.com/sonht113/dev-analyst/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  }
}
